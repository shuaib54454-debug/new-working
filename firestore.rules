rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == "shuaib54454@gmail.com";
    }

    function hasOnlySelectionFields() {
      return request.resource.data.keys().hasOnly([
        "candidateId",
        "candidateName",
        "clientUid",
        "clientEmail",
        "status",
        "createdAt"
      ]);
    }

    match /candidates/{candidateId} {
      allow read, write: if isOwner();
    }

    match /selections/{selectionId} {
      allow create: if isSignedIn()
        && hasOnlySelectionFields()
        && request.resource.data.clientUid == request.auth.uid
        && request.auth.token.email is string
        && request.resource.data.clientEmail is string
        && request.resource.data.clientEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.status == "Pending"
        && request.resource.data.candidateId is string
        && request.resource.data.candidateName is string
        && request.resource.data.createdAt == request.time;

      allow read: if isOwner()
        || (isSignedIn() && resource.data.clientUid == request.auth.uid);

      allow update, delete: if isOwner();
    }

    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    match /settings/{userId} {
      allow read, write: if isOwner();
    }

    match /activities/{activityId} {
      allow read, write: if isOwner();
    }

    match /_system/{docId} {
      allow read, write: if isOwner();
    }
  }
}
